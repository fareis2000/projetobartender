# =========================================================
# EXEMPLO DE VARIÁVEIS DE AMBIENTE (COPIE PARA .env NA RAIZ)
# =========================================================

# Modo de conexão com o ESP32: auto | wifi | serial | simulator
ESP32_MODE=auto

# Configuração Wi-Fi do ESP32 (IP fixo ou mDNS)
ESP32_HOST=bartender.local
ESP32_PORT=80

# Token opcional de segurança entre Backend e ESP32 (igual ao SECRET_API_TOKEN em bombas/secrets.h)
ESP32_API_TOKEN=

# Fallback USB Serial (ESP32 usa 115200 por padrão)
SERIAL_PORT=COM3
SERIAL_BAUD=115200

# Capacidade máxima de segurança do copo (ml)
MAX_CUP_ML=450

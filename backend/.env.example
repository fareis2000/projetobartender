# ============================================================================
# CONFIGURAÇÃO DO SERVIDOR BARTENDER.OS v3.0 (MULTI-BARES + PIX)
# ============================================================================
# Instruções de Uso:
#   1. Copie este arquivo para `backend/.env` (ou `.env` na raiz de `projetobartender-v3`).
#   2. Nunca versione o arquivo `.env` real no Git (ele contém senhas administrativas).
#   3. Os tokens do Mercado Pago de cada bar NÃO precisam ficar aqui: cada dono de bar
#      cadastra seu próprio Access Token diretamente no Painel Web (`/painel`)!
# ============================================================================

# Porta padrão 8010 (não conflita com a versão Alpha v2 da porta 8000!)
PORT=8010

# URL pública HTTPS quando hospedado na nuvem ou túnel (ex: https://app.bartenderos.com.br)
# Usada automaticamente nos QR Codes imprimíveis e nos Webhooks do Mercado Pago!
# Se deixada em branco, o backend infere dinamicamente pelo cabeçalho Host / X-Forwarded-Host.
PUBLIC_BASE_URL=

# Segredo criptográfico opcional para assinatura de tokens JWT (HMAC-SHA256) e tempo de sessão.
# Caso JWT_SECRET seja omitido, o sistema gera e persiste automaticamente uma chave segura
# de 48 bytes em `backend/data/.jwt_secret` no primeiro boot.
# JWT_SECRET=
# JWT_TTL_SECONDS=604800

# Caminho customizado opcional do arquivo SQLite (padrão: backend/data/bartender_v3.db)
# BARTENDER_DB_PATH=

# Credenciais iniciais do Super-Admin da Plataforma (você!)
# Utilizadas no primeiro boot para criar o registro raiz na tabela `platform_admins`.
SUPERADMIN_EMAIL=superadmin@bartender.os
SUPERADMIN_PASSWORD=troque-esta-senha-forte

# Credenciais iniciais do Bar Demo criado no primeiro boot
# Utilizadas para popular o tenant demonstrativo `Bar Tropical Demo` (`/painel`) com garrafas e drinks.
DEFAULT_BAR_EMAIL=dono@bartropical.com
DEFAULT_BAR_PASSWORD=bar123

# Janelas de tempo (segundos)
# - PIX_EXPIRATION_SECONDS: validade da cobrança Pix antes de expirar automaticamente (padrão 5 min).
# - TURN_WINDOW_SECONDS: tempo máximo em que a máquina aguarda o cliente da vez confirmar o copo na
#   plataforma antes de colocar seu pedido em espera protegida (`PAUSED_TURN`) e liberar a fila!
PIX_EXPIRATION_SECONDS=300
TURN_WINDOW_SECONDS=75

# Hardware fallback p/ primeira máquina demo
# Modos suportados em ESP32_MODE: cloud_iot | auto | wifi | serial | simulator
# Em produção comercial SaaS recomenda-se `cloud_iot` ou `auto` (ESP conecta no Wi-Fi 2.4 GHz do bar).
ESP32_MODE=auto
ESP32_HOST=bartender.local
ESP32_PORT=80
# ESP32_API_TOKEN=
SERIAL_PORT=COM3
SERIAL_BAUD=115200
MAX_CUP_ML=450

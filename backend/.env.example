# =========================================================
# EXEMPLO DE VARIÁVEIS DE AMBIENTE (COPIE PARA .env NA RAIZ)
# =========================================================
# Papel na Arquitetura:
#   Template público e seguro (versionado no Git) para configuração inicial
#   do backend FastAPI. Em produção ou bancada, copie este arquivo para
#   `projetobartender/.env` (ignorado pelo .gitignore) para definir credenciais
#   e parâmetros padrão de boot sem expor segredos no controle de versão.
#
# Nota sobre Precedência:
#   As configurações de transporte (modo, host, porta HTTP e porta COM) podem
#   ser alteradas dinamicamente em tempo de execução pela interface web (Painel ⚙️),
#   sendo persistidas em `backend/data/connection.json`. Já `ESP32_API_TOKEN` e
#   `MAX_CUP_ML` permanecem governados exclusivamente pelo ambiente por segurança.
# =========================================================

# Modo de conexão com o ESP32: auto | wifi | serial | simulator
# - auto: tenta Wi-Fi HTTP -> fallback USB Serial -> fallback Simulador Volumétrico (ideal para feiras/demos)
# - wifi: exige comunicação HTTP direta com o ESP32 na rede local
# - serial: exige cabo USB conectado na porta COM especificada
# - simulator: força modo de demonstração comercial sem acionar relés físicos
ESP32_MODE=auto

# Configuração Wi-Fi do ESP32 (IP fixo ex: 192.168.1.50, SoftAP 192.168.4.1 ou hostname mDNS)
ESP32_HOST=bartender.local
ESP32_PORT=80

# Token opcional de segurança entre Backend e ESP32 (igual ao SECRET_API_TOKEN em bombas/secrets.h)
# Enviado no cabeçalho HTTP `X-Bartender-Token` em rotas críticas (/dispense, /stop, /config/pumps)
ESP32_API_TOKEN=

# Fallback USB Serial (ESP32 usa 115200 por padrão)
# No Windows use COM3, COM4, etc.; no Linux/macOS use /dev/ttyUSB0 ou /dev/cu.usbserial-*
SERIAL_PORT=COM3
SERIAL_BAUD=115200

# Capacidade máxima de segurança do copo (ml) — evita transbordamento físico na bancada
MAX_CUP_ML=450
